{
    "ir_version": "0.1",
    "name": "simple_diffamp",
    "pdk": "sky130",
    "instances": [
        {
            "id": "DPAIR",
            "block": "sky130.diff_pair",
            "params": {
                "fingers": 4,
                "width": 2.0,
                "length": 0.5,
                "tail_width": 4.0
            },
            "placement": {
                "x": 0.0,
                "y": 10.0,
                "rotation": 0,
                "mirror": false
            }
        },
        {
            "id": "LOAD1",
            "block": "sky130.current_mirror",
            "params": {
                "fingers": 4,
                "width": 1.5,
                "length": 0.5,
                "type": "pmos"
            },
            "placement": {
                "x": 5.0,
                "y": 20.0,
                "rotation": 0,
                "mirror": true
            }
        },
        {
            "id": "LOAD2",
            "block": "sky130.current_mirror",
            "params": {
                "fingers": 4,
                "width": 1.5,
                "length": 0.5,
                "type": "pmos"
            },
            "placement": {
                "x": 15.0,
                "y": 20.0,
                "rotation": 0,
                "mirror": true
            }
        }
    ],
    "nets": [
        {
            "name": "vdd",
            "pins": ["LOAD1.in", "LOAD2.in"]
        },
        {
            "name": "outp",
            "pins": ["DPAIR.outp", "LOAD1.out"]
        },
        {
            "name": "outn",
            "pins": ["DPAIR.outn", "LOAD2.out"]
        }
    ],
    "constraints": [
        {
            "type": "symmetric",
            "instances": ["LOAD1", "LOAD2"],
            "axis": "vertical",
            "note": "Match active loads for CMRR"
        },
        {
            "type": "align",
            "instances": ["LOAD1", "LOAD2", "DPAIR"],
            "edge": "center_x"
        }
    ],
    "ports": [
        {
            "name": "inp",
            "pin": "DPAIR.inp",
            "direction": "input"
        },
        {
            "name": "inn",
            "pin": "DPAIR.inn",
            "direction": "input"
        },
        {
            "name": "outp",
            "pin": "LOAD1.out",
            "direction": "output"
        },
        {
            "name": "outn",
            "pin": "LOAD2.out",
            "direction": "output"
        }
    ],
    "testbenches": [
        {
            "name": "tb_tran",
            "source": "extracted",
            "analysis": "tran",
            "vdd": 1.8,
            "stimulus": "V_VDD vdd 0 1.8\nV_VSS vss 0 0\nV_inn inn 0 0.9\nV_inp inp 0 PWL(0 0.9 50n 0.9 60n 1.3)\nR_outp_u vdd outp 10k\nR_outp_d outp vss 1Meg\nR_outn_u vdd outn 10k\nR_outn_d outn vss 1Meg\n.control\ntran 2n 1u\nwrdata waves.dat v(inp) v(inn) v(outp) v(outn)\n.endc",
            "probes": [],
            "specs": [
                {"name": "inp_settle", "signal": "inp", "measure": "settling",
                 "max": 2e-07, "unit": "s", "tol": 0.02},
                {"name": "inp_slew", "signal": "inp", "measure": "slew",
                 "min": 1e7, "max": 2e8, "unit": "V/s"},
                {"name": "inp_overshoot", "signal": "inp", "measure": "overshoot",
                 "max": 5.0, "unit": "%"},
                {"name": "outp_final", "signal": "outp", "measure": "final",
                 "min": 1.5, "max": 1.9, "unit": "V"}
            ]
        }
    ],
    "meta": {
        "author": "layout-canvas",
        "description": "Simple differential amplifier example",
        "date": "2026-09-11"
    }
}
