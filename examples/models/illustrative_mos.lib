* ILLUSTRATIVE level-1 MOS wrappers — NOT foundry silicon data.
* Purpose: interface smoke tests of the ngspice pipeline only.
* Exposes the canonical SkyWater subckt cell names so generated decks
* run unchanged; replace with the real deck (examples/models/sky130/
* sky130_tt.lib, or a foundry corner lib) for any serious run.
.subckt sky130_fd_pr__nfet_01v8 d g s b
.param l=1u w=1u nf=1 mult=1
m1 d g s b nfet_illu w={w} l={l}
.model nfet_illu nmos level=1 vto=0.4  kp=200u lambda=0.02 gamma=0.4 phi=0.7
.ends
.subckt sky130_fd_pr__pfet_01v8 d g s b
.param l=1u w=1u nf=1 mult=1
m1 d g s b pfet_illu w={w} l={l}
.model pfet_illu pmos level=1 vto=-0.4 kp=80u  lambda=0.02 gamma=0.4 phi=0.7
.ends
